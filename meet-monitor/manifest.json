{
  "manifest_version": 3,
  "name": "Meet Monitor",
  "version": "1.9.4",
  "description": "Logs Google Meet activity and can forward it to an ASG WhatsApp bot.",
  "permissions": ["storage", "alarms", "sidePanel", "tabs"],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [{
    "matches": ["https://meet.google.com/*"],
    "js": ["src/meet-policy.js", "src/selectors.js", "src/state.js", "src/meet-chat.js", "src/identity-probe.js", "src/content.js"],
    "run_at": "document_idle"
  }],
  "background": { "service_worker": "src/background.js" },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Meet Monitor"
  },
  "side_panel": { "default_path": "src/side-panel.html" },
  "options_page": "src/options.html"
}
